# Servidor
PORT=3000
NODE_ENV=development

# Banco de dados (Postgres local via docker-compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/casa_da_arvore

# Fila assíncrona (Redis local via docker-compose) — Etapa 5
REDIS_URL=redis://localhost:6379

# Endpoint de ingestão genérico (substitui o webhook do WhatsApp Meta)
# Chave que a automação existente (Make) deve enviar no header "X-Api-Key"
INGEST_API_KEY=defina-uma-chave-forte-aqui

# API Anthropic (extração de dados + briefing mensal)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# E-mail do briefing mensal (Resend ou SendGrid)
RESEND_API_KEY=
BRIEFING_RECIPIENT_EMAIL=financeiro@casadaarvoreadventure.com.br

# E-mail de notificação de handoff (Seção 5) — opcional, cai pra
# BRIEFING_RECIPIENT_EMAIL se não definido
HANDOFF_NOTIFICATION_EMAIL=

# WhatsApp do vendedor que recebe o lead no handoff (formato internacional).
# Sem isso, o handoff notifica só por e-mail. Atenção: só recebe texto livre
# dentro de 24h da última mensagem do vendedor pro número do bot (regra da Meta).
VENDEDOR_WHATSAPP_NUMBER=

# WhatsApp Business Cloud API (Meta) — usado só pelo webhook de TESTE em
# /webhooks/whatsapp. Preencher depois de criar o app no Meta for Developers.
WHATSAPP_VERIFY_TOKEN=defina-um-token-qualquer-aqui
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Painel mínimo de visibilidade (GET /painel, Seção 7) — HTTP Basic Auth.
# Sem as duas, a rota fica desativada (503), nunca aberta sem senha.
PAINEL_USERNAME=
PAINEL_PASSWORD=
