# Servidor
PORT=3000
NODE_ENV=development

# Banco de dados (Postgres local via docker-compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/casa_da_arvore

# Fila assíncrona (Redis local via docker-compose) — Etapa 5
REDIS_URL=redis://localhost:6379

# Endpoint de ingestão genérico (substitui o webhook do WhatsApp Meta)
# Chave que a automação existente (Make) deve enviar no header "X-Api-Key"
INGEST_API_KEY=defina-uma-chave-forte-aqui

# API Anthropic (extração de dados + briefing mensal)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# E-mail do briefing mensal (Resend ou SendGrid)
RESEND_API_KEY=
BRIEFING_RECIPIENT_EMAIL=financeiro@casadaarvoreadventure.com.br

# WhatsApp Business Cloud API (Meta) — usado só pelo webhook de TESTE em
# /webhooks/whatsapp. Preencher depois de criar o app no Meta for Developers.
WHATSAPP_VERIFY_TOKEN=defina-um-token-qualquer-aqui
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
